{
  "name": "stdio",
  "version": "2.2.0",
  "description": "Standard input/output manager for Node.js",
  "files": [
    "dist/**/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint --fix src test",
    "test": "jest --config jestconfig.json",
    "prepublishOnly": "npm test && npm run lint",
    "prepare": "npm run build",
    "preversion": "npm run lint",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgmonda/stdio.git"
  },
  "keywords": [
    "standard",
    "input",
    "console",
    "output",
    "terminal",
    "system",
    "arguments",
    "cli",
    "repl"
  ],
  "author": "Sergio Garcia Mondaray <sgmonda@gmail.com> (http://sgmonda.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sgmonda/stdio/issues"
  },
  "homepage": "https://github.com/sgmonda/stdio#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "mock-stdin": "^1.0.0",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      "minimatch": "^11.0.9"
    },
    "eslint-plugin-sonarjs": {
      "minimatch": "^11.0.9"
    },
    "@jest/reporters": {
      "minimatch": "^11.0.9"
    }
  }
}
